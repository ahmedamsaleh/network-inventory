<%- include('../partials/header', { pageTitle: 'Users' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Users', subtitle: 'accounts that signed up (the whitelist is under Validated users)', breadcrumbs: [['Users']],
        actions: '<a class="btn btn-default" href="/validatedusers"><i class="fa fa-user-plus"></i> Validated users</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Edit user', template: '/users/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'user-update-form' },
        { label: 'Delete user', template: '/users/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'user-delete-form', confirm: 'Delete the selected user account? The audit log keeps the last copy.' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/users/pagination', columns: columns.users, sortName: 'email' }) %>
</div>
<%- include('../partials/footer') %>
