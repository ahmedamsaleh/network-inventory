<%- include('../partials/header', { pageTitle: 'Edit ' + (user.name || user.email) }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + (user.name || user.email), subtitle: user.email, breadcrumbs: [['Users', '/users'], [user.name || user.email, '/users/' + user._id], ['Edit']] }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <form method="POST" action="/users/<%= user._id %>/?_method=PUT">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Account</strong></div>
                <div class="panel-body">
                    <%- include('../partials/field', { name: 'ro-email', label: 'E-mail', value: user.email, readonly: true, help: 'The e-mail is the login name and cannot be changed' }) %>
                    <%- include('../partials/field', { name: 'user[name]', label: 'Name', value: user.name, required: true, maxlength: 64 }) %>
                    <%- include('../partials/field', { name: 'user[role]', label: 'Role', type: 'select', value: user.role, options: roles.map(function (r) { return [r, r]; }), help: 'Administrators can restore and permanently delete devices and edit accounts' }) %>
                </div>
            </div>
            <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/users/' + user._id }) %>
        </form>
    </div></div>
</div>
<%- include('../partials/footer') %>
