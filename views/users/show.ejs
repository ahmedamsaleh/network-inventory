<%- include('../partials/header', { pageTitle: user.name || user.email }) %>
<%
  let actions = '';
  if (isAdmin) actions += '<a class="btn btn-warning" href="/users/' + user._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/users/' + user._id + '/?_method=DELETE" method="POST" data-confirm="Delete the account ' + user.email + '? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
%>
<div class="container">
    <%- include('../partials/page-header', { title: user.name || user.email, subtitle: user.email, breadcrumbs: [['Users', '/users'], [user.name || user.email]], actions: actions }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <%- include('../partials/details', { title: 'Account', rows: [
            ['Name', user.name], ['E-mail', user.email],
            ['Role', '<span class="label ' + (user.role === 'admin' ? 'label-primary' : 'label-default') + ' label-lg">' + user.role + '</span>', { raw: true }],
            ['E-mail verified', '<span class="label ' + (user.isAuthenticated ? 'label-success' : 'label-warning') + ' label-lg">' + (user.isAuthenticated ? 'yes' : 'not yet') + '</span>', { raw: true }],
        ] }) %>
        <% if (currentUser && String(currentUser._id) === String(user._id)) { %><p class="text-muted"><i class="fa fa-info-circle"></i> This is your account.</p><% } %>
    </div></div>
</div>
<%- include('../partials/footer') %>
