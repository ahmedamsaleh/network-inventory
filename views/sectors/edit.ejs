<%- include('../partials/header', { pageTitle: 'Edit ' + sector.name }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + sector.name, breadcrumbs: [['Sectors', '/sectors'], [sector.name, '/sectors/' + sector._id], ['Edit']] }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <form method="POST" action="/sectors/<%= sector._id %>/?_method=PUT">
            <%- include('_form', { sector: sector }) %>
            <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/sectors/' + sector._id }) %>
        </form>
    </div></div>
</div>
<%- include('../partials/footer') %>
