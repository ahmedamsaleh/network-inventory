<%- include('../partials/header', { pageTitle: 'Sectors' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Sectors', breadcrumbs: [['Sectors']] }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add sector', href: '/sectors/new', cls: 'btn-primary', icon: 'fa-plus', id: 'sector-add-form' },
        { label: 'Edit sector', template: '/sectors/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'sector-update-form' },
        { label: 'Delete sector', template: '/sectors/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'sector-delete-form', confirm: 'Delete the selected sector? The audit log keeps the last copy.' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/sectors/pagination', columns: columns.sectors, sortName: 'name' }) %>
</div>
<%- include('../partials/footer') %>
