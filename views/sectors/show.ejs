<%- include('../partials/header', { pageTitle: sector.name }) %>
<%
  let actions = '<a class="btn btn-warning" href="/sectors/' + sector._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/sectors/' + sector._id + '/?_method=DELETE" method="POST" data-confirm="Delete sector ' + sector.name + '? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
%>
<div class="container">
    <%- include('../partials/page-header', { title: sector.name, subtitle: 'sector', breadcrumbs: [['Sectors', '/sectors'], [sector.name]], actions: actions }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <%- include('../partials/details', { title: 'Sector', rows: [
            ['Name', sector.name], ['Description', sector.description],
            ['Devices', '<a href="/devices?filter[sectorName]=' + encodeURIComponent(sector.name) + '">' + (typeof deviceCount !== 'undefined' ? deviceCount : 0) + ' active device(s)</a>', { raw: true }],
            ['Added by', sector.author && sector.author.email ? sector.author.email : 'imported'],
        ] }) %>
    </div></div>
</div>
<%- include('../partials/footer') %>
