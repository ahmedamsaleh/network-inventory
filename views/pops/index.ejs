<%- include('../partials/header', { pageTitle: 'POPs' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'POPs', subtitle: 'points of presence', breadcrumbs: [['POPs']],
        actions: '<a class="btn btn-default" href="/cabinets"><i class="fa fa-archive"></i> Cabinets</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add POP', href: '/pops/new', cls: 'btn-primary', icon: 'fa-plus', id: 'pop-add-form' },
        { label: 'Edit POP', template: '/pops/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'pop-update-form' },
        { label: 'Delete POP', template: '/pops/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'pop-delete-form', confirm: 'Delete the selected POP? The audit log keeps the last copy.' },
    ] }) %>
    <div class="panel panel-default">
        <div class="panel-body">
            <form action="/pops/import" method="POST" enctype="multipart/form-data" class="form-inline">
                <div class="form-group">
                    <label for="pop-import-file"><i class="fa fa-upload"></i> Import the POPs sheet</label>
                    <input id="pop-import-file" type="file" name="file" accept=".csv,.xlsx,text/csv" required>
                </div>
                <button type="submit" class="btn btn-default">Import</button>
                <span class="help-block" style="display:inline-block; margin:0 0 0 10px">CSV or XLSX ("POPs" sheet): shortName, cty, district, sector, popType, popLongName &ndash; existing POPs are updated by short name.</span>
            </form>
        </div>
    </div>
    <%- include('../partials/data-table', { url: '/pops/pagination', columns: columns.pops, sortName: 'name' }) %>
</div>
<%- include('../partials/footer') %>
