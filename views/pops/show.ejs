<%- include('../partials/header', { pageTitle: pop.name }) %>
<%
  let actions = '<a class="btn btn-warning" href="/pops/' + pop._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/pops/' + pop._id + '/?_method=DELETE" method="POST" data-confirm="Delete POP ' + pop.name + '? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
  const ctyText = pop.cty && pop.cty !== 'Unknown' ? pop.cty : (pop.countyAcro && pop.countyAcro.acronym) || pop.cty;
%>
<div class="container">
    <%- include('../partials/page-header', { title: pop.name, subtitle: pop.shortName, breadcrumbs: [['POPs', '/pops'], [pop.name]], actions: actions }) %>
    <div class="row">
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'POP', rows: [
                ['Name', pop.name], ['Short name', pop.shortName], ['POP long name', pop.popLongName], ['POP type', pop.popType],
                ['County', ctyText], ['District', pop.district], ['Sector', pop.sector],
                ['pop_cty', pop.pop_cty], ['Parent POP', pop.parentPOP],
            ] }) %>
        </div>
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'Usage', rows: [
                ['Devices', '<a href="/devices?search=' + encodeURIComponent(pop.shortName || pop.name) + '">' + (typeof usage !== 'undefined' ? usage.devices : 0) + ' active device(s)</a>', { raw: true }],
                ['Cabinets', typeof usage !== 'undefined' && usage.cabinets.length ? usage.cabinets.map(function (c) { return '<a href="/cabinets/' + c._id + '">' + c.cabinet + '</a>'; }).join(', ') : '', { raw: true }],
                ['Added by', pop.author && pop.author.email ? pop.author.email : 'imported'],
            ] }) %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
