<%- include('../partials/header', { pageTitle: 'Edit ' + pop.name }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + pop.name, subtitle: pop.shortName, breadcrumbs: [['POPs', '/pops'], [pop.name, '/pops/' + pop._id], ['Edit']] }) %>
    <form method="POST" action="/pops/<%= pop._id %>/?_method=PUT">
        <%- include('_form', { pop: pop }) %>
        <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/pops/' + pop._id }) %>
    </form>
</div>
<%- include('../partials/footer') %>
