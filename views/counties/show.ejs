<%- include('../partials/header', { pageTitle: county.name }) %>
<%
  let actions = '<a class="btn btn-warning" href="/counties/' + county._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/counties/' + county._id + '/?_method=DELETE" method="POST" data-confirm="Delete county ' + county.name + '? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
%>
<div class="container">
    <%- include('../partials/page-header', { title: county.name, subtitle: county.acronym, breadcrumbs: [['Counties', '/counties'], [county.name]], actions: actions }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <%- include('../partials/details', { title: 'County', rows: [
            ['Name', county.name], ['Acronym', county.acronym],
            ['Devices', '<a href="/devices?filter[county]=' + encodeURIComponent(county.name) + '">' + (typeof deviceCount !== 'undefined' ? deviceCount : 0) + ' active device(s)</a>', { raw: true }],
            ['POPs', '<a href="/pops?filter[cty]=' + encodeURIComponent(county.acronym || '') + '">' + (typeof popCount !== 'undefined' ? popCount : 0) + ' POP(s) with this acronym</a>', { raw: true }],
            ['Added by', county.author && county.author.email ? county.author.email : 'imported'],
        ] }) %>
    </div></div>
</div>
<%- include('../partials/footer') %>
