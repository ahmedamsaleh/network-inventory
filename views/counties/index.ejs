<%- include('../partials/header', { pageTitle: 'Counties' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Counties', breadcrumbs: [['Counties']] }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add county', href: '/counties/new', cls: 'btn-primary', icon: 'fa-plus', id: 'county-add-form' },
        { label: 'Edit county', template: '/counties/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'county-update-form' },
        { label: 'Delete county', template: '/counties/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'county-delete-form', confirm: 'Delete the selected county? The audit log keeps the last copy.' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/counties/pagination', columns: columns.counties, sortName: 'name' }) %>
</div>
<%- include('../partials/footer') %>
