<%- include('../partials/header', { pageTitle: 'Edit ' + county.name }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + county.name, breadcrumbs: [['Counties', '/counties'], [county.name, '/counties/' + county._id], ['Edit']] }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <form method="POST" action="/counties/<%= county._id %>/?_method=PUT">
            <%- include('_form', { county: county }) %>
            <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/counties/' + county._id }) %>
        </form>
    </div></div>
</div>
<%- include('../partials/footer') %>
