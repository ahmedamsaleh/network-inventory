<%- include('../partials/header') %>
<div class="container">
    <!--<will need to create my own style sheet to center the 2 inputs and make them
    smaller>-->
    <div class="row">
        <h1 style="text-align: center;">Edit <%= county.name %></h1>
        <!--<margin 25 px for top and bottom, auto for left and right>-->
        <div style="width:30%; margin:25px auto;">
            <form method="POST" action="/counties/<%= county._id %>/?_method=PUT">
                <!--<use form-group to make spacing between components>-->
                <div class="form-group">
                    <label for="name">County Name</label>
                    <input class="form-control" type="text" name="county[name]" value="<%= county.name %>" readonly>
                </div>
                <div class="form-group">
                    <label for="acronym">County Acronym</label>
                    <input class="form-control" type="text" name="county[acronym]" value="<%= county.acronym %>">
                </div>
                <div class="form-group">
                    <!--<btn-block will let the button takes width of the 2 inputs>-->
                    <button class="btn btn-lg btn-primary btn-block">Submit!</button>
                </div>
            </form>
            <!--<a href="/devices/<%= county._id %>/">Go Back</a>-->
            <a href="/counties/">Go Back</a>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>