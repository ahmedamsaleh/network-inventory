<%- include('../partials/header') %>
<div class="container">
    <!--<will need to create my own style sheet to center the 2 inputs and make them
    smaller>-->
    <div class="row">
        <h1 style="text-align: center;">Add A New Device</h1>
        <!--<margin 25 px for top and bottom, auto for left and right>-->
        <div style="width:30%; margin:25px auto;">
            <form method="POST" action="/devices">
                <!--<use form-group to make spacing between components>-->
                <div class="form-group">
                    <label for="hostname">Host Name</label>
                    <input class="form-control" type="text" name="device[hostname]" >
                </div>
                <div class="form-group">
                    <label for="ipaddress">IP Address</label>
                    <input class="form-control" type="text" name="device[ipaddress]" >
                </div>
                <div class="form-group">
                    <label for="community">SNMP Community</label>
                    <input class="form-control" type="text" name="device[community]" placeholder="default community">
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <input class="form-control" type="text" name="device[description]" >
                </div>
                <div class="form-group">
                    <label for="device-pop-name">POP Name</label>
                    <select id="new-device-pop-name" class="form-control select2-single" type="text" name="device[popName][name]">
                    <option value="NONE"></option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="device-sector-name">Sector Name</label>
                    <select id="new-device-sector-name" class="form-control select2-single" type="text" name="device[sector][name]"  >
                    <option value="NONE"></option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="device-county-name">County Name</label>
                    <select id="new-device-county-name" class="form-control select2-single" type="text" name="device[county][name]" >
                    <option value="NONE"></option>
                    </select>
                </div>
                <div class="form-group">
                    <!-- <input class="form-control" type="text" name="device[type]" placeholder="type"> -->
                    <label for="deviceType">Type</label>
                    <select class="form-control selectpicker" name="device[type]" >
                      <option>Router</option>
                      <option>Switch</option>
                      <option>Access Switch</option>
                      <option>DSLAM</option>
                      <option>MSAN</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="model">Model</label>
                    <input class="form-control" type="text" name="device[model]" >
                </div>
                <div class="form-group">
                    <label for="vendor">Vendor</label>
                    <input class="form-control" type="text" name="device[vendor]" >
                </div>
                <div class="form-group">
                    <label for="pop">POP (short code)</label>
                    <input class="form-control" type="text" name="device[pop]" >
                </div>
                <div class="form-group">
                    <label for="popLongName">POP Long Name</label>
                    <input class="form-control" type="text" name="device[popLongName]" placeholder="Unkown">
                </div>
                <div class="form-group">
                    <label for="popType">POP Type</label>
                    <input class="form-control" type="text" name="device[popType]" placeholder="Unkown">
                </div>
                <div class="form-group">
                    <label for="cabinet">Cabinet</label>
                    <input class="form-control" type="text" name="device[cabinet]" placeholder="Unkown">
                </div>
                <div class="form-group">
                    <label for="cty">County (code)</label>
                    <input class="form-control" type="text" name="device[cty]" placeholder="Unkown">
                </div>
                <div class="form-group">
                    <label for="district">District</label>
                    <input class="form-control" type="text" name="device[district]" placeholder="Unkown">
                </div>
                <div class="form-group">
                    <label for="btMSANCode">BT MSAN Code</label>
                    <input class="form-control" type="text" name="device[btMSANCode]" >
                </div>
                <div class="form-group">
                    <label for="btMngIP">BT Management IP</label>
                    <input class="form-control" type="text" name="device[btMngIP]" >
                </div>
                <div class="form-group">
                    <label for="btSector">BT Sector</label>
                    <input class="form-control" type="text" name="device[btSector]" >
                </div>
                <div class="form-group">
                    <label for="btDistrict">BT District</label>
                    <input class="form-control" type="text" name="device[btDistrict]" >
                </div>
                <div class="form-group">
                    <!--<btn-block will let the button takes width of the 2 inputs>-->
                    <button class="btn btn-lg btn-primary btn-block">Discover</button>
                </div>
            </form>
            <a href="/devices">Go Back</a>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>