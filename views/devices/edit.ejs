<%- include('../partials/header', { pageTitle: 'Edit ' + device.hostname }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + device.hostname, subtitle: device.ipaddress, breadcrumbs: [['Devices', '/devices'], [device.hostname, '/devices/' + device._id], ['Edit']] }) %>
    <% if (device.decommissioned) { %><div class="alert alert-warning">This device is decommissioned; changes are saved but it stays out of the active lists until an administrator restores it.</div><% } %>
    <form method="POST" action="/devices/<%= device._id %>?_method=PUT" id="device-form">
        <%- include('_form', { device: device, types: types }) %>
        <div class="panel panel-default">
            <div class="panel-heading"><strong>Discovery</strong> <small class="text-muted">read only, maintained by the SNMP sync</small></div>
            <table class="table table-condensed app-details">
                <tbody>
                    <tr><th>sysName</th><td><%= h.text(device.sysName) %></td><th>sysObjectID</th><td class="app-mono"><%= h.text(device.sysObjectID) %></td></tr>
                    <tr><th>sysDescr</th><td colspan="3"><%= h.text(device.sysDescr) %></td></tr>
                    <tr><th>Last sync</th><td><%= h.dateTime(device.lastSyncTime) || '—' %></td><th>Sync cycles</th><td><%= device.deviceSyncCycles %></td></tr>
                    <tr><th>Consecutive timeouts</th><td><%= device.snmpTimeouts || 0 %></td><th>Last sync error</th><td><%= h.text(device.lastSyncError) %></td></tr>
                </tbody>
            </table>
        </div>
        <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/devices/' + device._id }) %>
    </form>
</div>
<%- include('../partials/footer') %>
