<%- include('../partials/header', { pageTitle: device.hostname }) %>
<%
  const r = related || {};
  const label = (text, cls) => '<span class="label ' + cls + ' label-lg">' + text + '</span>';
  const popName = device.popName && device.popName.name;
  const popLink = r.pop ? '<a href="/pops/' + r.pop._id + '">' + h.text(popName || r.pop.name) + '</a>' : h.text(popName);
  const cabinetLink = r.cabinet ? '<a href="/cabinets/' + r.cabinet._id + '">' + device.cabinet + '</a>' : h.text(device.cabinet);
  const modelLink = r.deviceModel ? '<a href="/devicemodels/' + r.deviceModel._id + '">' + device.model + '</a>' : h.text(device.model);
  const btLink = r.btInfo ? '<a href="/btmsaninfos/' + r.btInfo._id + '">' + (device.btMSANCode || r.btInfo.msanCode) + '</a>' : h.text(device.btMSANCode);
  const profile = snmpProfile === 'flag' ? 'slow (flagged by hand)' : snmpProfile === 'timeouts' ? 'slow (' + device.snmpTimeouts + ' consecutive timeouts)' : 'default' + (device.snmpTimeouts ? ' (' + device.snmpTimeouts + ' consecutive timeouts)' : '');
  let actions = '<a class="btn btn-warning" href="/devices/' + device._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  if (!device.decommissioned) {
    actions += '<a class="btn btn-info" href="/devices/sync/' + device._id + '"><i class="fa fa-refresh"></i> Sync now</a>';
    actions += '<a class="btn btn-primary" href="/interfaces/new?device=' + device._id + '"><i class="fa fa-plus"></i> Add interface</a>';
    actions += '<a class="btn btn-danger" id="decommission-button" href="/devices/' + device._id + '/decommission"><i class="fa fa-power-off"></i> Decommission</a>';
  } else if (isAdmin) {
    actions += '<a class="btn btn-success" id="restore-button" href="/devices/' + device._id + '/restore"><i class="fa fa-undo"></i> Restore</a>';
  }
  if (isAdmin) {
    actions += '<form id="delete-form" action="/devices/' + device._id + '/?_method=DELETE" method="POST" data-confirm="Permanently delete ' + device.hostname + ' and all its interfaces? This cannot be undone (the audit log keeps the last copy)."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete permanently</button></form>';
  }
%>
<div class="container">
    <%- include('../partials/page-header', { title: device.hostname, subtitle: device.ipaddress, breadcrumbs: [['Devices', '/devices'], [device.hostname]], actions: actions }) %>

    <% if (device.decommissioned) { %>
        <div class="alert alert-warning app-banner" id="decommissioned-banner">
            <i class="fa fa-power-off"></i> <strong>Decommissioned</strong>
            on <%= h.dateTime(device.decommissionedAt) %>
            by <%= device.decommissionedBy && device.decommissionedBy.email %>
            <% if (device.decommissionReason) { %> &ndash; reason: <em><%= device.decommissionReason %></em><% } %>.
            The device is hidden from the active lists, is not synchronised and its <%= r.archivedCount %> interface record(s) are archived.
            <% if (isAdmin) { %>An administrator can <a href="/devices/<%= device._id %>/restore">restore</a> it.<% } else { %>Ask an administrator to restore it.<% } %>
            <a href="/audit?target=<%= device._id %>">Audit trail</a>
        </div>
    <% } %>

    <div class="row">
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'Identity', rows: [
                ['Hostname', device.hostname],
                ['IP address', device.ipaddress],
                ['Description', device.description],
                ['SNMP community', device.community],
                ['Type', device.type],
                ['Model', modelLink, { raw: true }],
                ['Vendor', device.vendor],
                ['Default collector', device.defaultCollector],
                ['Status', device.decommissioned ? label('decommissioned', 'label-warning') : label('active', 'label-success'), { raw: true }],
            ] }) %>
            <%- include('../partials/details', { title: 'Location', rows: [
                ['POP', popLink, { raw: true }],
                ['POP (short code)', device.pop],
                ['POP long name', device.popLongName],
                ['POP type', device.popType],
                ['Cabinet', cabinetLink, { raw: true }],
                ['Sector', device.sector && device.sector.name],
                ['County', device.county && device.county.name ? device.county.name : ''],
                ['County (code)', device.cty],
                ['District', device.district],
            ] }) %>
        </div>
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'BT MSAN reference', rows: [
                ['BT MSAN code', btLink, { raw: true }],
                ['BT management IP', device.btMngIP],
                ['BT sector', device.btSector],
                ['BT district', device.btDistrict],
                ['Reference entry', r.btInfo ? '<a href="/btmsaninfos/' + r.btInfo._id + '">' + r.btInfo.msanCode + '</a> (' + (r.btInfo.mngIP || 'no management IP') + ', ' + r.btInfo.sector + ' / ' + r.btInfo.district + ')' : 'no BT MSAN info matches this device', { raw: true, cls: r.btInfo ? '' : 'text-muted' }],
            ] }) %>
            <%- include('../partials/details', { title: 'SNMP / synchronisation', rows: [
                ['sysName', device.sysName],
                ['sysObjectID', device.sysObjectID ? '<span class="app-mono">' + device.sysObjectID + '</span>' : '', { raw: true }],
                ['sysDescr', device.sysDescr],
                ['Discovered', device.discovered ? label('yes', 'label-success') : label('not yet', 'label-default'), { raw: true }],
                ['Last sync', h.dateTime(device.lastSyncTime)],
                ['Sync cycles', device.deviceSyncCycles],
                ['SNMP profile', '<span id="snmp-profile">' + profile + '</span>', { raw: true }],
                ['Last sync error', device.lastSyncError, { cls: 'text-danger' }],
                ['Interfaces', (device.decommissioned ? r.archivedCount + ' archived' : r.interfaceCount + ' active') + ', ' + (device.interfaces || []).length + ' in the last snapshot'],
                ['Links', '<a href="/links?search=' + encodeURIComponent(device.hostname) + '">' + r.linkCount + ' link(s)</a> reference this hostname', { raw: true }],
            ] }) %>
            <%- include('../partials/details', { title: 'History', rows: [
                ['Created', h.dateTime(device.createdAt) + (device.author && device.author.email ? ' by ' + device.author.email : '')],
                ['Last updated', h.dateTime(device.updatedAt) + (device.lastUpdatedBy && device.lastUpdatedBy.email ? ' by ' + device.lastUpdatedBy.email : '')],
                ['Decommissioned', device.decommissioned ? h.dateTime(device.decommissionedAt) + ' by ' + (device.decommissionedBy && device.decommissionedBy.email) + (device.decommissionReason ? ' - ' + device.decommissionReason : '') : ''],
                ['Restored', h.dateTime(device.restoredAt)],
                ['Audit trail', '<a href="/audit?target=' + device._id + '">all entries of this device</a>', { raw: true }],
            ] }) %>
        </div>
    </div>

    <h3 class="app-section-title"><i class="fa fa-plug"></i> Interfaces
        <small><%= device.decommissioned ? 'snapshot taken before decommissioning (the live records are archived)' : 'live records; every field is available through the column picker' %></small>
    </h3>
    <% if (!device.decommissioned) { %>
        <%- include('../partials/toolbar', { buttons: [
            { label: 'Add interface', href: '/interfaces/new?device=' + device._id, cls: 'btn-primary', icon: 'fa-plus' },
            { label: 'Edit interface', template: '/interfaces/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'interface-update-form' },
            { label: 'Delete interface', template: '/interfaces/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'interface-delete-form', confirm: 'Delete the selected interface? The audit log keeps the last copy.' },
        ] }) %>
        <%- include('../partials/data-table', { url: '/interfaces/pagination?filter[hostname]=' + encodeURIComponent(device.hostname), columns: columns.interfaces.filter(function (c) { return c.field !== 'hostname'; }), sortName: 'ifIndex', pageSize: 25 }) %>
    <% } else { %>
        <div class="table-responsive app-table">
            <table id="snapshotTable" data-toggle="table" data-pagination="true" data-page-size="25" data-search="true" data-show-columns="true" data-striped="true">
                <thead>
                    <tr>
                        <th data-field="index" data-sortable="true">ifIndex</th>
                        <th data-field="name" data-sortable="true">ifName</th>
                        <th data-field="alias" data-sortable="true">ifAlias</th>
                        <th data-field="description">ifDescr</th>
                        <th data-field="type" data-sortable="true">Type</th>
                        <th data-field="speed" data-sortable="true">Speed</th>
                        <th data-field="adminStatus">Admin status</th>
                        <th data-field="operStatus">Oper status</th>
                        <th data-field="isDeviceUpLink">Device uplink</th>
                    </tr>
                </thead>
                <tbody>
                <% (device.interfaces || []).forEach(function (intf) { %>
                    <tr>
                        <td><%= intf.ifIndex !== undefined && intf.ifIndex !== null ? intf.ifIndex : intf.index %></td>
                        <td><%= intf.ifName || intf.name %></td>
                        <td><%= intf.ifAlias || intf.alias %></td>
                        <td><%= intf.ifDescr || intf.description %></td>
                        <td><%= intf.type %></td>
                        <td><%= h.bitrate(intf.ifSpeed || intf.speed) %></td>
                        <td><%= intf.adminStatus %></td>
                        <td><%= intf.operStatus %></td>
                        <td><%= h.yesNo(intf.isDeviceUpLink) %></td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
<%- include('../partials/footer') %>
