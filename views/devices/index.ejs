<%- include('../partials/header', { pageTitle: 'Devices' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Devices', subtitle: 'active inventory', breadcrumbs: [['Devices']],
        actions: '<a class="btn btn-default" href="/devices/decommissioned"><i class="fa fa-power-off"></i> Decommissioned devices</a><a class="btn btn-default" href="/audit"><i class="fa fa-history"></i> Audit log</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add device', href: '/devices/new', cls: 'btn-primary', icon: 'fa-plus', id: 'device-add-form' },
        { label: 'Edit device', template: '/devices/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'device-update-form' },
        { label: 'Sync device', template: '/devices/sync/{id}', method: 'GET', cls: 'btn-info', icon: 'fa-refresh', id: 'device-sync-form' },
        { label: 'Decommission device', template: '/devices/{id}/decommission', method: 'GET', cls: 'btn-danger', icon: 'fa-power-off', id: 'device-decommission-form' },
        { label: 'Sync all devices', href: '/devices/sync', cls: 'btn-default', icon: 'fa-refresh' },
        { label: 'Import (CSV/XLSX)', href: '/enrichments/import', cls: 'btn-default', icon: 'fa-upload' },
        { label: 'Export', href: '/enrichments/export', cls: 'btn-default', icon: 'fa-download' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/devices/pagination', columns: columns.devices, sortName: 'hostname' }) %>
</div>
<%- include('../partials/footer') %>
