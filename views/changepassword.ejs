<%- include('partials/header', { pageTitle: 'Change password' }) %>
<div class="container app-form">
    <div class="row">
        <div class="col-sm-6 col-sm-offset-3 col-md-4 col-md-offset-4">
            <div class="panel panel-default">
                <div class="panel-heading"><strong><i class="fa fa-key"></i> Change password</strong></div>
                <div class="panel-body">
                    <p class="help-block">Self-service password changes are not available yet: an administrator has to reset the account. The form is kept for the coming implementation.</p>
                    <form action="/changepass" method="POST">
                        <%- include('partials/field', { name: 'email', id: 'loginEmail', label: 'E-mail address', type: 'email', required: true, maxlength: 128 }) %>
                        <%- include('partials/field', { name: 'newpass', id: 'newPassword', label: 'New password', type: 'password', required: true, minlength: 6 }) %>
                        <%- include('partials/field', { name: 'newpassconfirm', id: 'confirmPassword', label: 'Confirm password', type: 'password', required: true, minlength: 6 }) %>
                        <button type="submit" class="btn btn-primary btn-block">Submit</button>
                    </form>
                </div>
                <div class="panel-footer text-muted"><small><a href="/login">Back to login</a></small></div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
