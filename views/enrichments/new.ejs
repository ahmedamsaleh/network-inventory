<%- include('../partials/header', { pageTitle: 'Import enrichment data' }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Import enrichment data', subtitle: 'legacy B_TED CSV', breadcrumbs: [['Enrichment table', '/enrichments'], ['Import']] }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading"><strong>Enrichment CSV</strong></div>
            <div class="panel-body">
                <p class="help-block">One row per interface with the <code>B_TED_*</code> columns (SE_Name first). Rows are appended to the enrichment table and applied to the matching interfaces (a device is created for every hostname not seen before). The import runs in the background.</p>
                <form id="dropzoneForm" action="/enrichments" class="dropzone" method="POST" enctype="multipart/form-data">
                    <div class="dz-message">Drop the CSV file here or click to choose it</div>
                </form>
                <hr>
                <form action="/enrichments" method="POST" enctype="multipart/form-data" class="form-inline">
                    <div class="form-group">
                        <label for="enrichment-file">Without drag &amp; drop:</label>
                        <input id="enrichment-file" type="file" name="file" accept=".csv,text/csv" required>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-upload"></i> Upload and import</button>
                    <a class="btn btn-default" href="/enrichments">Cancel</a>
                </form>
            </div>
        </div>
    </div></div>
</div>
<%- include('../partials/footer') %>
