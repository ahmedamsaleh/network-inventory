<%- include('../partials/header', { pageTitle: 'Edit ' + (interface.ifName || interface.name || 'interface') }) %>
<%
  // fields: Interface.fieldCatalog (models/interface.js) - every field is rendered here
  const groups = [];
  for (const field of fields) {
    let group = groups.find((g) => g.name === field.group);
    if (!group) { group = { name: field.group, fields: [] }; groups.push(group); }
    group.fields.push(field);
  }
  const hostname = interface.hostname || (interface.device && interface.device.hostname) || '';
  const name = interface.ifName || interface.name || '';
  function fieldValue(field) {
    const value = interface[field.name];
    if (value === undefined || value === null) return '';
    if (field.kind === 'date') return value instanceof Date ? value.toISOString() : String(value);
    if (field.kind === 'json') return JSON.stringify(value);
    return String(value);
  }
%>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + name, subtitle: 'on ' + hostname, breadcrumbs: [['Interfaces', '/interfaces'], [name, '/interfaces/' + interface._id], ['Edit']] }) %>
    <form action="/interfaces/<%= interface._id %>?_method=PUT" method="POST" id="interface-form">
        <% groups.forEach(function (group) { %>
        <div class="panel panel-default <%= group.name === 'International' ? 'app-international' : '' %>">
            <div class="panel-heading"><strong><%= group.name %></strong>
                <% if (group.name === 'International') { %><small class="text-muted">only used when the link type is "International"</small><% } %>
                <% if (group.name === 'Parsed alias') { %><small class="text-muted">re-parsed from ifAlias whenever the alias changes</small><% } %>
            </div>
            <div class="panel-body">
                <div class="row">
                <% group.fields.forEach(function (field) { %>
                    <div class="col-md-4">
                    <% if (field.name === 'adminStatus' || field.name === 'operStatus') { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, type: 'select', value: fieldValue(field), options: ['', 'up', 'down', 'testing'].concat(fieldValue(field) && !['', 'up', 'down', 'testing'].includes(fieldValue(field)) ? [fieldValue(field)] : []).map(function (o) { return [o, o === '' ? '(none)' : o]; }) }) %>
                    <% } else if (field.kind === 'select') { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, type: 'select', value: fieldValue(field), options: field.options.map(function (o) { return [o, o === '' ? '(none)' : o]; }) }) %>
                    <% } else if (field.kind === 'boolean') { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, type: 'select', value: interface[field.name] ? 'yes' : 'no', options: [['no', 'no'], ['yes', 'yes']] }) %>
                    <% } else if (field.readOnly) { %>
                        <%- include('../partials/field', { name: 'ro-' + field.name, id: 'interface-' + field.name, label: field.label, value: fieldValue(field), readonly: true, help: field.group === 'Device' ? 'from the owning device' : 'read only' }) %>
                    <% } else if (field.kind === 'number') { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, type: 'number', value: fieldValue(field), step: field.name === 'ifIndex' || field.name === 'ifType' || field.name === 'syncCycles' || field.name === 'unknownFlag' ? 1 : 'any', min: 0, required: field.name === 'ifIndex', title: 'a number' }) %>
                    <% } else if (field.kind === 'date') { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, value: fieldValue(field), placeholder: 'YYYY-MM-DD or ISO date-time', pattern: '\\d{4}-\\d{2}-\\d{2}([T ].*)?', title: 'YYYY-MM-DD or an ISO date-time' }) %>
                    <% } else { %>
                        <%- include('../partials/field', { name: 'interface[' + field.name + ']', id: 'interface-' + field.name, label: field.label, value: fieldValue(field), required: field.name === 'ifName', maxlength: 255 }) %>
                    <% } %>
                    </div>
                <% }); %>
                </div>
            </div>
        </div>
        <% }); %>
        <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/interfaces/' + interface._id }) %>
    </form>
</div>
<%- include('../partials/footer') %>
