<%- include('../partials/header') %>
<%
  // fields: Interface.fieldCatalog (models/interface.js) - every field is rendered here
  const groups = [];
  for (const field of fields) {
    let group = groups.find((g) => g.name === field.group);
    if (!group) { group = { name: field.group, fields: [] }; groups.push(group); }
    group.fields.push(field);
  }
  function fieldValue(field) {
    const value = interface[field.name];
    if (value === undefined || value === null) return '';
    if (field.kind === 'date') return value instanceof Date ? value.toISOString() : String(value);
    if (field.kind === 'json') return JSON.stringify(value);
    return String(value);
  }
%>
<div class="container">
    <div class="row">
        <h1 style="text-align: center">Edit Interface <%= interface.ifName || interface.name %> <small>on <%= interface.hostname || (interface.device && interface.device.hostname) %></small></h1>
        <div style="width: 60%; margin: 25px auto;">
            <form action="/interfaces/<%= interface._id %>?_method=PUT" method="POST">
                <% groups.forEach(function (group) { %>
                <h3><%= group.name %></h3>
                <div class="row">
                    <% group.fields.forEach(function (field) { %>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="interface-<%= field.name %>"><%= field.label %></label>
                            <% if (field.kind === 'select') { %>
                            <select id="interface-<%= field.name %>" class="form-control" name="interface[<%= field.name %>]">
                                <% field.options.forEach(function (option) { %>
                                <option value="<%= option %>" <%= fieldValue(field) === option ? 'selected' : '' %>><%= option === '' ? '(none)' : option %></option>
                                <% }); %>
                            </select>
                            <% } else if (field.kind === 'boolean') { %>
                            <select id="interface-<%= field.name %>" class="form-control" name="interface[<%= field.name %>]">
                                <option value="no" <%= interface[field.name] ? '' : 'selected' %>>no</option>
                                <option value="yes" <%= interface[field.name] ? 'selected' : '' %>>yes</option>
                            </select>
                            <% } else if (field.readOnly) { %>
                            <input id="interface-<%= field.name %>" class="form-control" type="text" value="<%= fieldValue(field) %>" readonly>
                            <% } else { %>
                            <input id="interface-<%= field.name %>" class="form-control" type="<%= field.kind === 'number' ? 'number' : 'text' %>" <%= field.kind === 'number' ? 'step="any"' : '' %> name="interface[<%= field.name %>]" value="<%= fieldValue(field) %>" <%= field.kind === 'date' ? 'placeholder="ISO date, e.g. 2024-01-31T10:00:00Z"' : '' %>>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% }); %>
                <div class="form-group">
                    <button class="btn btn-lg btn-primary btn-block">Submit!</button>
                </div>
            </form>
            <a href="/interfaces/">Go Back</a>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
