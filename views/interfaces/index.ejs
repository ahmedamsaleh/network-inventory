<%- include('../partials/header', { pageTitle: 'Interfaces' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Interfaces', subtitle: 'every field of the interface catalogue is available through the column picker', breadcrumbs: [['Interfaces']],
        actions: '<a class="btn btn-default" href="/enrichments/export"><i class="fa fa-download"></i> Export</a><a class="btn btn-default" href="/enrichments/check/secondpop"><i class="fa fa-check"></i> secondPOP check</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Edit interface', template: '/interfaces/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'interface-update-form' },
        { label: 'Delete interface', template: '/interfaces/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'interface-delete-form', confirm: 'Delete the selected interface? The audit log keeps the last copy.' },
    ] }) %>
    <p class="text-muted"><i class="fa fa-info-circle"></i> Interfaces are discovered by the SNMP sync; to add one by hand open the device page and use <em>Add interface</em>.</p>
    <%- include('../partials/data-table', { url: '/interfaces/pagination', columns: columns.interfaces, sortName: 'hostname' }) %>
</div>
<%- include('../partials/footer') %>
