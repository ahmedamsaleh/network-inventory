<%- include('partials/header', { pageTitle: title }) %>
<div class="container">
    <div class="row">
        <div class="col-md-6 col-md-offset-3 text-center" style="margin-top: 40px;">
            <h1><i class="fa <%= typeof failed !== 'undefined' && failed ? 'fa-times-circle text-danger' : 'fa-envelope-o text-success' %>"></i> <%= title %></h1>
            <% if (typeof message !== 'undefined' && message) { %><p class="lead"><%= message %></p><% } %>
            <a href="/login" class="btn btn-primary">Go to login</a>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
