<%- include('../partials/header', { pageTitle: 'Edit link' }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit link', subtitle: link.device1 + '/' + link.interface1 + ' - ' + link.device2 + '/' + link.interface2, breadcrumbs: [['Links', '/links'], [link.device1 + ' - ' + link.device2, '/links/' + link._id], ['Edit']] }) %>
    <form method="POST" action="/links/<%= link._id %>/?_method=PUT">
        <%- include('_form', { link: link, types: types }) %>
        <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/links/' + link._id }) %>
    </form>
</div>
<%- include('../partials/footer') %>
