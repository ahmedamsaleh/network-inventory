<%- include('../partials/header', { pageTitle: 'Links' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Links', subtitle: 'device-to-device connections', breadcrumbs: [['Links']],
        actions: '<a class="btn btn-default" href="/enrichments/check/secondpop"><i class="fa fa-check"></i> secondPOP check</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add link', href: '/links/new', cls: 'btn-primary', icon: 'fa-plus', id: 'link-add-form' },
        { label: 'Edit link', template: '/links/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'link-update-form' },
        { label: 'Delete link', template: '/links/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'link-delete-form', confirm: 'Delete the selected link? The audit log keeps the last copy.' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/links/pagination', columns: columns.links, sortName: 'device1' }) %>
</div>
<%- include('../partials/footer') %>
