<%- include('../partials/header', { pageTitle: 'Link ' + link.device1 + ' - ' + link.device2 }) %>
<%
  let actions = '<a class="btn btn-warning" href="/links/' + link._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/links/' + link._id + '/?_method=DELETE" method="POST" data-confirm="Delete this link? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
  const hostLink = (hostname) => hostname ? '<a href="/devices/hostname/' + encodeURIComponent(hostname) + '">' + hostname + '</a>' : '';
%>
<div class="container">
    <%- include('../partials/page-header', { title: link.device1 + ' - ' + link.device2, subtitle: 'link', breadcrumbs: [['Links', '/links'], [link.device1 + ' - ' + link.device2]], actions: actions }) %>
    <div class="row">
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'Endpoints', rows: [
                ['Device 1', hostLink(link.device1), { raw: true }], ['Interface 1', link.interface1], ['POP 1', link.pop1],
                ['Device 2', hostLink(link.device2), { raw: true }], ['Interface 2', link.interface2], ['POP 2', link.pop2],
            ] }) %>
        </div>
        <div class="col-md-6">
            <%- include('../partials/details', { title: 'Link', rows: [
                ['Type', link.type], ['Special service', link.specialService], ['Label', link.label],
                ['Speed', link.speed ? h.number(link.speed) + ' bit/s (' + h.bitrate(link.speed) + ')' : ''],
                ['Created', h.dateTime(link.createdAt) + (link.author && link.author.email ? ' by ' + link.author.email : ' (imported)')],
                ['Last update', h.dateTime(link.lastUpdate)],
            ] }) %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
