<%- include('partials/header', { pageTitle: 'Login' }) %>
<div class="container app-form">
    <div class="row">
        <div class="col-sm-6 col-sm-offset-3 col-md-4 col-md-offset-4">
            <div class="panel panel-default">
                <div class="panel-heading"><strong><i class="fa fa-sign-in"></i> Login</strong></div>
                <div class="panel-body">
                    <form action="/login" method="POST">
                        <%- include('partials/field', { name: 'email', id: 'loginEmail', label: 'E-mail address', type: 'email', required: true, placeholder: 'name@example.com', maxlength: 128 }) %>
                        <%- include('partials/field', { name: 'password', id: 'loginPassword', label: 'Password', type: 'password', required: true, placeholder: 'Password' }) %>
                        <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-sign-in"></i> Login</button>
                    </form>
                </div>
                <div class="panel-footer text-muted">
                    <small>No account yet? <a href="/signup">Sign up</a> (the e-mail must be on the validated users list) &middot; <a href="/changepass">Forgot password</a></small>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
