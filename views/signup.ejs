<%- include('partials/header', { pageTitle: 'Sign up' }) %>
<% const f = typeof form !== 'undefined' && form ? form : {}; %>
<div class="container app-form">
    <div class="row">
        <div class="col-sm-6 col-sm-offset-3 col-md-4 col-md-offset-4">
            <div class="panel panel-default">
                <div class="panel-heading"><strong><i class="fa fa-user-plus"></i> Sign up</strong></div>
                <div class="panel-body">
                    <p class="help-block">Only e-mail addresses on the validated users list can sign up; ask an administrator to be added.</p>
                    <form id="signupform" action="/signup" method="POST">
                        <%- include('partials/field', { name: 'name', id: 'InputName', label: 'Full name', value: f.name, required: true, maxlength: 64, placeholder: 'First and last name' }) %>
                        <%- include('partials/field', { name: 'email', id: 'InputEmail', label: 'E-mail address', type: 'email', value: f.email, required: true, maxlength: 128, placeholder: 'name@example.com' }) %>
                        <%- include('partials/field', { name: 'password', id: 'InputPassword', label: 'Password', type: 'password', required: true, minlength: 6, placeholder: 'at least 6 characters', help: 'At least 6 characters' }) %>
                        <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-user-plus"></i> Sign up</button>
                    </form>
                </div>
                <div class="panel-footer text-muted"><small>Already registered? <a href="/login">Login</a></small></div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
