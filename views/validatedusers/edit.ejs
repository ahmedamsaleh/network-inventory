<%- include('../partials/header', { pageTitle: 'Edit ' + user.email }) %>
<div class="container app-form">
    <%- include('../partials/page-header', { title: 'Edit ' + user.email, breadcrumbs: [['Validated users', '/validatedusers'], [user.email, '/validatedusers/' + user._id], ['Edit']] }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <form method="POST" action="/validatedusers/<%= user._id %>/?_method=PUT">
            <%- include('_form', { user: user, roles: roles }) %>
            <%- include('../partials/form-actions', { label: 'Save changes', cancelHref: '/validatedusers/' + user._id }) %>
        </form>
    </div></div>
</div>
<%- include('../partials/footer') %>
