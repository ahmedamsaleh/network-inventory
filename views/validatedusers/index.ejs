<%- include('../partials/header', { pageTitle: 'Validated users' }) %>
<div class="container">
    <%- include('../partials/page-header', { title: 'Validated users', subtitle: 'whitelist of the e-mail addresses allowed to sign up, with their role', breadcrumbs: [['Validated users']],
        actions: '<a class="btn btn-default" href="/users"><i class="fa fa-users"></i> Users</a>' }) %>
    <%- include('../partials/toolbar', { buttons: [
        { label: 'Add validated user', href: '/validatedusers/new', cls: 'btn-primary', icon: 'fa-plus', id: 'validateduser-add-form' },
        { label: 'Edit', template: '/validatedusers/{id}/edit', method: 'GET', cls: 'btn-warning', icon: 'fa-pencil', id: 'validateduser-update-form' },
        { label: 'Delete', template: '/validatedusers/{id}/?_method=DELETE', method: 'POST', cls: 'btn-danger', icon: 'fa-trash', id: 'validateduser-delete-form', confirm: 'Remove the selected e-mail from the whitelist? The audit log keeps the last copy.' },
    ] }) %>
    <%- include('../partials/data-table', { url: '/validatedusers/pagination', columns: columns.validatedusers, sortName: 'email' }) %>
</div>
<%- include('../partials/footer') %>
