<%- include('../partials/header', { pageTitle: user.email }) %>
<%
  let actions = '<a class="btn btn-warning" href="/validatedusers/' + user._id + '/edit"><i class="fa fa-pencil"></i> Edit</a>';
  actions += '<form id="delete-form" action="/validatedusers/' + user._id + '/?_method=DELETE" method="POST" data-confirm="Remove ' + user.email + ' from the whitelist? The audit log keeps the last copy."><button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button></form>';
%>
<div class="container">
    <%- include('../partials/page-header', { title: user.email, subtitle: user.name, breadcrumbs: [['Validated users', '/validatedusers'], [user.email]], actions: actions }) %>
    <div class="row"><div class="col-md-8 col-md-offset-2">
        <%- include('../partials/details', { title: 'Validated user', rows: [
            ['Name', user.name], ['E-mail', user.email],
            ['Role', '<span class="label ' + (user.role === 'admin' ? 'label-primary' : 'label-default') + ' label-lg">' + user.role + '</span>', { raw: true }],
            ['Account', typeof account !== 'undefined' && account ? '<a href="/users/' + account._id + '">signed up</a>' + (account.isAuthenticated ? ', e-mail verified' : ', e-mail not verified yet') : 'not signed up yet', { raw: true }],
            ['Added by', user.author && user.author.email ? user.author.email : ''],
        ] }) %>
    </div></div>
</div>
<%- include('../partials/footer') %>
