{
  "name": "network-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Network Inventory - SNMP discovery + inventory (Express/Mongoose/Passport/EJS)",
  "main": "application.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node application.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "bash scripts/fetch-mongod.sh",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "cron": "^1.8.2",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.19.0",
    "ip-address": "^10.7.4",
    "method-override": "^3.0.0",
    "mongoose": "^9.10.3",
    "mongoose-csv": "^1.1.0",
    "mongoose-paginate-v2": "^1.9.5",
    "net-snmp": "^3.26.3",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.2.0",
    "string": "^3.3.3",
    "through": "^2.3.8",
    "winston": "~2.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^9.5.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
