# Copy to .env and adjust. Real environment variables take precedence.
# Never commit .env (it is git-ignored and scanned for by gitleaks).

# HTTP server
IP=127.0.0.1
PORT=8080

# express-session secret (REQUIRED - the app refuses to start without it)
SESSION_SECRET=

# Key external systems send in the x-api-key header for /enrichments/api/* (optional)
API_KEY=

# Administrator account created at startup if it does not exist (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# MongoDB database name on mongodb://localhost (or set MONGO_URL to override the whole URL)
DEV_DB=network-inventory
#MONGO_URL=mongodb://localhost/network-inventory
# Seconds (in ms) to wait for MongoDB at startup before exiting with an error
MONGO_CONNECT_TIMEOUT_MS=10000
# Embedded development MongoDB when nothing answers at the URL above: auto | never | always
EMBEDDED_MONGO=auto
#EMBEDDED_MONGO_PATH=./data/db

# Seed demo devices when opening the "new" forms (true/false)
SEED=false
# Set to WIN on Windows (import/export path separators)
#OS=WIN

# SNMP discovery: community used for devices created without one
DEFAULT_SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT_MS=60000
SNMP_RETRIES=5
# IIB rule: a device whose community equals COMMUNITY_KEY1 (a placeholder sent
# by IIB) is polled with COMMUNITY_VALUE1 (the real string, kept only here).
# More pairs: COMMUNITY_KEY2/COMMUNITY_VALUE2, ...
COMMUNITY_KEY1=
COMMUNITY_VALUE1=
SNMP_MAX_REPETITIONS=20
# local address to send SNMP requests from (optional)
#SNMP_SOURCE_ADDRESS=10.0.0.5
# shorter profile for devices known to be slow (flagged on the device, or after
# SNMP_SLOW_AFTER_TIMEOUTS consecutive timed-out syncs; 0 disables the automatic part)
SNMP_SLOW_TIMEOUT_MS=10000
SNMP_SLOW_RETRIES=1
SNMP_SLOW_AFTER_TIMEOUTS=3
# device sync: devices polled in parallel, cycles before a missing interface is flagged
SYNC_CONCURRENCY=4
SYNC_CYCLES_THRESHOLD=3

# Automatic device sync schedule (sec min hour day month weekday) and timezone
SYNC_CRON=0 0 0 */2 * *
SYNC_TIMEZONE=Europe/Dublin

# Account verification e-mails (SMTP_USER/SMTP_PASS optional)
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_SUBJECT=Activate your Network Inventory account
